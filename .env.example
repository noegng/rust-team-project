# Copy to `.env` (ignored by git) at the repo root, or in any parent of the
# directory `cargo run -p node` is launched from (dotenvy looks upwards).
# Variables already set in the shell take precedence: several local nodes can
# share one `.env` and override SECRET_KEY / PORT on the command line.

# This node's ed25519 secret key (64 hex chars): `openssl rand -hex 32`.
# Never commit it.
SECRET_KEY=

# Public keys of all validators (printed at startup as "node public key"),
# comma separated, in the SAME order on every node: it defines the rotation.
AUTHORIZED_VALIDATORS=

# HTTP API + WebSocket port (default 8001, the client's default NODE_URL).
PORT=8001
